{
  "name": "nijashwa-studio-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nijashwa Studio — Windows desktop app (Electron shell around the web build in www/)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nijashwa.studio",
    "productName": "Nijashwa Studio",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www", "filter": ["**/*"] }],
    "win": {
      "target": "portable",
      "artifactName": "NijashwaStudio.exe"
    }
  }
}
